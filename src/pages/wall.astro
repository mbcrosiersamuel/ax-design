---
import BaseLayout from '@layouts/BaseLayout.astro';
import wallData from '../data/wall.json';
import { DEFAULT_STATE, filterItems, groupBySite, minRowPosts, options, renderAgentOptions, renderPatternOptions, renderRows, summary, type WallItem } from '@lib/wall';

const items = wallData as unknown as WallItem[];
const today = new Date().toISOString().slice(0, 10);
const opts = options(items, DEFAULT_STATE, today);

const shown = filterItems(items, DEFAULT_STATE, today);
const rows = groupBySite(shown, minRowPosts(DEFAULT_STATE));
const sum = summary(shown, rows);
const rowsHtml = renderRows(rows, today);
---

<BaseLayout
  title="Wall | agentexperience.design"
  description="Real posts from X and Reddit about AI agents on consumer websites, one row per site."
>
  <div class="wall" data-today={today}>
    <div class="container">
      <section class="hero" aria-label="Summary">
        <p class="big"><span id="pct">{sum.pct ?? '–'}</span><small>%</small></p>
        <p class="hero__text">
          of agent attempts got through.
          <span id="sum-posts">{sum.posts}</span> <span id="w-posts">{sum.posts === 1 ? 'post' : 'posts'}</span>,
          <span id="sum-sites">{sum.sites}</span> <span id="w-sites">{sum.sites === 1 ? 'site' : 'sites'}</span>,
          <span id="sum-agents">{sum.agents}</span> <span id="w-agents">{sum.agents === 1 ? 'assistant' : 'assistants'}</span>.
        </p>
      </section>

      <div class="bar">
        <div class="tog" role="group" aria-label="Time window">
          <button type="button" data-days="30" aria-pressed="true">30 days</button>
          <button type="button" data-days="0" aria-pressed="false">All</button>
        </div>
        <select id="f-agent" aria-label="Assistant" set:html={renderAgentOptions(opts, DEFAULT_STATE)}></select>
        <select id="f-pattern" aria-label="Pattern" set:html={renderPatternOptions(opts, DEFAULT_STATE)}></select>
        <a class="json" href="/wall.json">JSON</a>
      </div>

      <table class="ledger">
        <thead>
          <tr><th scope="col">Site</th><th scope="col">Posts</th><th scope="col">Latest</th></tr>
        </thead>
        <tbody id="rows" set:html={rowsHtml} />
      </table>
      <p class="empty" id="empty" hidden>Nothing here.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .wall {
    padding-block: var(--space-6) var(--space-16);
  }

  /* Big number */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-text);
  }

  .big {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .big small {
    font-size: 0.4em;
    color: var(--color-text-muted);
    letter-spacing: 0;
  }

  .hero__text {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--line-normal);
  }

  .hero__text span[id^='sum-'] {
    color: var(--color-text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Bar */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .tog {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .tog button {
    min-height: 36px;
    padding: 0 var(--space-3);
    font: inherit;
    color: var(--color-text);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .tog button[aria-pressed='true'] {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .bar select {
    min-height: 36px;
    max-width: 14rem;
    padding: 0 var(--space-6) 0 0;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-text);
    background: transparent;
    border: 0;
    border-bottom: 1px dashed var(--color-text-muted);
    border-radius: 0;
    cursor: pointer;
  }

  .bar select.is-set {
    border-bottom: 2px solid var(--color-text);
  }

  .json {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .tog button:focus-visible,
  .bar select:focus-visible,
  .ledger :global(button:focus-visible),
  .ledger :global(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Ledger */
  .ledger {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .ledger thead th {
    text-align: left;
    font-weight: 500;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: var(--space-2) var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .ledger :global(td),
  .ledger :global(tbody th) {
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    text-align: left;
  }

  .ledger :global(tbody th) {
    white-space: nowrap;
    width: 1%;
  }

  .ledger :global(.row__open) {
    font: inherit;
    font-weight: 600;
    color: var(--color-text);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    min-height: 24px;
  }

  .ledger :global(.row__open::before) {
    content: '+';
    display: inline-block;
    width: 1.1em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .ledger :global(.row__open[aria-expanded='true']::before) {
    content: '\2013';
  }

  .ledger :global(.row__strip) {
    width: 16rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .ledger :global(.row__strip > .strip),
  .ledger :global(.row__strip > .tally) {
    display: inline-flex;
    vertical-align: top;
  }

  .ledger :global(.strip) {
    flex-wrap: wrap;
    gap: 2px;
    width: 10rem;
    margin-right: var(--space-2);
    padding-top: 4px;
  }

  .ledger :global(.tally) {
    gap: var(--space-2);
    white-space: nowrap;
  }

  .ledger :global(.sq) {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--color-border);
  }

  .ledger :global(.sq--worked) {
    background: var(--color-good);
  }

  .ledger :global(.sq--stuck) {
    background: var(--color-bad);
  }

  .ledger :global(.tally b) {
    font-weight: 500;
  }

  .ledger :global(.t-ok) {
    color: var(--color-good);
  }

  .ledger :global(.t-no) {
    color: var(--color-bad);
  }

  .ledger :global(.row__q) {
    overflow-wrap: anywhere;
  }

  .ledger :global(.row__q small) {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    margin-top: 2px;
  }

  .ledger :global(.detail > td) {
    background: var(--color-bg-subtle);
    padding: var(--space-4) var(--space-3);
  }

  .ledger :global(.embeds) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
  }

  /* One post inside an open row */
  .ledger :global(.post) {
    position: relative;
    min-width: 0;
    padding-left: var(--space-6);
  }

  .ledger :global(.post .m) {
    position: absolute;
    left: 0;
    top: 2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .ledger :global(.m--worked) {
    color: var(--color-good);
    background: var(--color-good-bg);
  }

  .ledger :global(.m--stuck) {
    color: var(--color-bad);
    background: var(--color-bad-bg);
  }

  .ledger :global(.m--mixed) {
    color: var(--color-text-muted);
    background: var(--color-border);
  }

  .ledger :global(.post__embed :is(.twitter-tweet, iframe)) {
    margin: 0 !important;
    max-width: 100% !important;
  }

  .ledger :global(.post__embed.is-pending) {
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }

  .ledger :global(.post.is-embedded .post__quote) {
    display: none;
  }

  .ledger :global(.post.is-embedded[data-kind='thread'] .post__quote) {
    display: block;
    margin-top: var(--space-2);
  }

  .ledger :global(.post.is-embedded[data-kind='thread'] .post__quote footer) {
    display: none;
  }

  .ledger :global(.post__quote p) {
    font-size: var(--text-base);
    line-height: var(--line-normal);
    overflow-wrap: anywhere;
  }

  .ledger :global(.post__quote footer) {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .ledger :global(.post__quote a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ledger :global(.post__tags) {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding: 0;
  }

  .ledger :global(.tag) {
    font-size: var(--text-xs);
    padding: 1px var(--space-2);
    border-radius: var(--radius-full);
  }

  .ledger :global(.tag--anti) {
    background: var(--color-bad-bg);
  }

  .ledger :global(.tag--good) {
    background: var(--color-good-bg);
  }

  .ledger :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .empty {
    padding: var(--space-10) 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .bar {
      gap: var(--space-3);
    }

    .tog {
      width: 100%;
    }

    .tog button {
      flex: 1;
    }

    .bar select {
      width: 100%;
      max-width: none;
      border-bottom-style: solid;
      border-bottom-color: var(--color-border);
    }

    .json {
      display: none;
    }

    .ledger thead th:nth-child(3),
    .ledger :global(.row__q) {
      display: none;
    }

    .ledger :global(.row__strip) {
      width: auto;
    }

    .ledger :global(.strip) {
      width: 6.5rem;
    }

  }
</style>

<script>
  import wallData from '../data/wall.json';
  import { DEFAULT_STATE, filterItems, groupBySite, minRowPosts, options, renderAgentOptions, renderPatternOptions, renderRows, summary, type WallItem, type WallState } from '@lib/wall';

  const items = wallData as unknown as WallItem[];
  const root = document.querySelector<HTMLElement>('.wall')!;
  const today = root.dataset.today!;
  const tbody = document.getElementById('rows')!;
  const empty = document.getElementById('empty')!;
  const agentSel = document.getElementById('f-agent') as HTMLSelectElement;
  const patternSel = document.getElementById('f-pattern') as HTMLSelectElement;
  const togs = [...document.querySelectorAll<HTMLButtonElement>('.tog button')];
  const state: WallState = { ...DEFAULT_STATE };
  const open = new Set<string>();

  for (const [k, v] of new URLSearchParams(location.search)) {
    if (k === 'days') state.days = Number(v) || 0;
    if (k === 'agent') state.agent = v;
    if (k === 'pattern') state.pattern = v;
    if (k === 'site') v.split(',').forEach((s) => open.add(s));
  }

  function syncUrl() {
    const params = new URLSearchParams();
    if (state.days !== DEFAULT_STATE.days) params.set('days', String(state.days));
    if (state.agent) params.set('agent', state.agent);
    if (state.pattern) params.set('pattern', state.pattern);
    if (open.size) params.set('site', [...open].join(','));
    history.replaceState(null, '', params.size ? '?' + params : location.pathname);
  }

  function render() {
    const shown = filterItems(items, state, today);
    const rows = groupBySite(shown, minRowPosts(state));
    const s = summary(shown, rows);
    document.getElementById('pct')!.textContent = s.pct === null ? '–' : String(s.pct);
    for (const [k, n, w] of [['posts', s.posts, 'post'], ['sites', s.sites, 'site'], ['agents', s.agents, 'assistant']] as const) {
      document.getElementById('sum-' + k)!.textContent = String(n);
      document.getElementById('w-' + k)!.textContent = n === 1 ? w : w + 's';
    }
    tbody.innerHTML = renderRows(rows, today);
    empty.hidden = rows.length > 0;
    togs.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.days) === state.days)));
    const o = options(items, state, today);
    agentSel.innerHTML = renderAgentOptions(o, state);
    patternSel.innerHTML = renderPatternOptions(o, state);
    agentSel.classList.toggle('is-set', !!state.agent);
    patternSel.classList.toggle('is-set', !!state.pattern);
    for (const site of [...open]) toggle(site, true);
    syncUrl();
  }

  function toggle(site: string, force?: boolean) {
    const row = tbody.querySelector<HTMLElement>(`.row[data-site="${CSS.escape(site)}"]`);
    if (!row) { open.delete(site); return; }
    const detail = row.nextElementSibling as HTMLElement;
    const btn = row.querySelector<HTMLButtonElement>('.row__open')!;
    const show = force ?? detail.hidden;
    detail.hidden = !show;
    btn.setAttribute('aria-expanded', String(show));
    if (show) {
      open.add(site);
      detail.querySelectorAll<HTMLElement>('.post:not(.is-loading)').forEach(embed);
    } else {
      open.delete(site);
    }
  }

  tbody.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.row__open');
    if (!btn) return;
    toggle(btn.closest<HTMLElement>('.row')!.dataset.site!);
    syncUrl();
  });
  togs.forEach((b) => b.addEventListener('click', () => { state.days = Number(b.dataset.days); render(); }));
  agentSel.addEventListener('change', () => { state.agent = agentSel.value; render(); });
  patternSel.addEventListener('change', () => { state.pattern = patternSel.value; render(); });

  /* Embeds: the real post replaces the quote when it loads. The quote stays if it does not. */
  const dark = matchMedia('(prefers-color-scheme: dark)').matches;
  let twitterReady: Promise<any> | undefined;
  function twitter() {
    twitterReady ||= new Promise((resolve, reject) => {
      // widgets.js posts the tweet height to the canonical origin. On a preview host, point it at this page.
      const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
      if (canonical && new URL(canonical.href).origin !== location.origin) canonical.href = location.href;
      const s = document.createElement('script');
      s.src = 'https://platform.twitter.com/widgets.js';
      s.async = true;
      s.onload = () => (window as any).twttr.ready(resolve);
      s.onerror = reject;
      document.head.append(s);
    });
    return twitterReady;
  }
  function discard(slot: HTMLElement) {
    slot.replaceChildren();
    const obs = new MutationObserver(() => slot.replaceChildren());
    obs.observe(slot, { childList: true });
    setTimeout(() => obs.disconnect(), 15000);
  }
  let redditTimer = 0;
  function redditScan() {
    clearTimeout(redditTimer);
    redditTimer = window.setTimeout(() => {
      const s = document.createElement('script');
      s.src = 'https://embed.reddit.com/widgets.js';
      s.async = true;
      document.body.append(s);
    }, 200);
  }
  function embed(post: HTMLElement) {
    post.classList.add('is-loading');
    const slot = post.querySelector<HTMLElement>('[data-slot]')!;
    if (post.dataset.platform === 'x') {
      const timeout = new Promise((r) => setTimeout(r, 12000));
      twitter()
        .then((t) => Promise.race([t.widgets.createTweet(post.dataset.postId, slot, { conversation: 'none', dnt: true, theme: dark ? 'dark' : 'light' }), timeout]))
        // A deleted post or account gives no element, and the widget then inserts a "Not found" card.
        .then((el: unknown) => { if (el) post.classList.add('is-embedded'); else discard(slot); })
        .catch(() => discard(slot));
      return;
    }
    // Reddit can answer with a block page. A real embed sends a resize message; show the frame only then.
    const bq = document.createElement('blockquote');
    bq.className = 'reddit-embed-bq';
    bq.dataset.embedHeight = '240';
    if (dark) bq.dataset.embedTheme = 'dark';
    bq.style.display = 'none';
    const a = document.createElement('a');
    a.href = post.dataset.url!;
    a.textContent = 'Reddit post';
    bq.append(a);
    slot.append(bq);
    slot.classList.add('is-pending');
    new MutationObserver((_, obs) => {
      const frame = slot.querySelector('iframe');
      if (!frame) return;
      obs.disconnect();
      const giveUp = setTimeout(() => { window.removeEventListener('message', onMessage); slot.replaceChildren(); slot.classList.remove('is-pending'); }, 10000);
      function onMessage(e: MessageEvent) {
        if (e.source !== frame!.contentWindow) return;
        clearTimeout(giveUp);
        window.removeEventListener('message', onMessage);
        slot.classList.remove('is-pending');
        post.classList.add('is-embedded');
      }
      window.addEventListener('message', onMessage);
    }).observe(slot, { childList: true, subtree: true });
    redditScan();
  }

  render();
</script>
